{
  "name": "renzos-loom",
  "productName": "Renzo's Loom",
  "version": "0.2.0",
  "description": "Coding agent with tabs, persistent context and image support, using OpenRouter as the provider",
  "author": "RenzoARG",
  "main": "src/main/main.js",
  "type": "module",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "build": "electron-builder --win --publish never",
    "build:dir": "electron-builder --win --dir --publish never",
    "release": "electron-builder --win --publish always"
  },
  "build": {
    "appId": "com.renzo.loom",
    "productName": "Renzo's Loom",
    "directories": {
      "output": "dist"
    },
    "publish": {
      "provider": "github",
      "owner": "RenzoARG",
      "repo": "Renzos-Loom",
      "releaseType": "release"
    },
    "files": [
      "src/**/*",
      "package.json",
      "!sessions/**",
      "!.env",
      "!.env.*",
      "!**/*.md",
      "!src/NOTES.md"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "src/assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "icon": "src/assets/icon.png"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "icon": "src/assets/icon.png"
    }
  },
  "dependencies": {
    "dotenv": "^16.4.0",
    "openai": "^4.0.0"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^26.18.0"
  },
  "allowScripts": {
    "electron@33.4.11": true
  }
}